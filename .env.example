NODE_ENV=DEV
PORT=4000
ROUTE=api
UI_LINK=http://localhost:5173
BACKEND_LINK=http://localhost:4000
FRONTEND_DOMAIN=http://localhost:5173

# Database Credentials
MONGO_DB=catalog-assistant
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_POOL_SIZE=10
CLUSTER_SIZE=1
MONGO_URI_PROD=

# JWT Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_BASIC=price_basic_123
STRIPE_PRICE_ID_PRO=price_pro_123

# AI RAG Pipeline Settings
AI_SIMILARITY_THRESHOLD=0.70
AI_MAX_RETRIEVAL_RESULTS=5

# Upload & File Limits
MAX_FILE_SIZE=10485760

# AWS S3 Storage
S3_ACCESS_KEY=your_aws_access_key_id
S3_SECRET_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name
S3_REGION=us-east-1